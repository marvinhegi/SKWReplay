<Window x:Class="SKWReplay.App.SaveSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aufnahme gespeichert"
        Width="480"
        SizeToContent="Height"
        MaxWidth="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource TextPrimary}"
        KeyDown="Window_KeyDown">
    <Border Margin="12"
            Padding="24"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="38" Height="38" Margin="0,0,12,0"
                        Background="#203D32" CornerRadius="19">
                    <TextBlock Text="✓" Foreground="#78D6A2" FontSize="21"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Aufnahme gespeichert" FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Dein Video wurde erfolgreich gespeichert."
                               Foreground="{StaticResource TextMuted}" FontSize="13"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Padding="12,10" Background="#1B2027"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="{Binding SavedFilePath}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}" FontSize="12"
                           AutomationProperties.Name="Speicherort der Aufnahme"/>
            </Border>

            <Button Content="Fertig" IsDefault="True" Click="Done_Click"
                    HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0"
                    Background="{StaticResource Accent}"
                    BorderBrush="{StaticResource Accent}"/>
        </StackPanel>
    </Border>
</Window>
