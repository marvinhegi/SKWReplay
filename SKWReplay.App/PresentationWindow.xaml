<Window x:Class="SKWReplay.App.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="Black">
    <Grid Background="Black">
        <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Fill"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
